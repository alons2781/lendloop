# Copy to .env.local (git-ignored). `bunx convex dev` fills in the CONVEX_* values on first run.

# Clerk (https://dashboard.clerk.com -> your app -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex-side variables (NOT in this file) are set with `bunx convex env set NAME value`:
#   CLERK_JWT_ISSUER_DOMAIN   your Clerk Frontend API URL
#   CLERK_WEBHOOK_SECRET      optional: Clerk webhook signing secret (whsec_...), for user.deleted cleanup
#   N8N_WEBHOOK_URL           public URL of n8n's /webhook/lendloop/loan-event
#   N8N_WEBHOOK_SECRET        HMAC key, Convex -> n8n   (same as LENDLOOP_WEBHOOK_SECRET in n8n/.env)
#   N8N_WEBHOOK_TOKEN         shared token, Convex -> n8n (same as LENDLOOP_WEBHOOK_TOKEN)
#   N8N_API_SECRET            HMAC key, n8n -> Convex   (same as LENDLOOP_API_SECRET)
#   N8N_API_TOKEN             shared token, n8n -> Convex (same as LENDLOOP_API_TOKEN)
