# Copy to n8n/.env (git-ignored) and fill in. Generate secrets with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Chicago

# Shared with Convex: set the SAME values there (bunx convex env set ...)
LENDLOOP_WEBHOOK_SECRET=
LENDLOOP_WEBHOOK_TOKEN=

# n8n -> Convex (overdue reminders). Different from the pair above; set the same
# values in Convex as N8N_API_SECRET / N8N_API_TOKEN. Site URL = your Convex
# deployment's .convex.site address (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local).
LENDLOOP_API_SECRET=
LENDLOOP_API_TOKEN=
LENDLOOP_CONVEX_SITE_URL=

# Where the app lives (used for links in emails) and who failure alerts go to
LENDLOOP_APP_URL=http://localhost:3000
LENDLOOP_MAIL_FROM="LendLoop <no-reply@lendloop.local>"
LENDLOOP_ALERT_EMAIL=alerts@lendloop.local

# Public https URL of n8n (needed once Convex must reach it; see README)
N8N_PUBLIC_URL=http://localhost:5678
